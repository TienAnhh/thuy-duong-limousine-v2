# Postgres connection string - lấy từ Vercel Storage (Neon) sau khi bấm "Connect to Project"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Chuỗi bí mật ký JWT phiên đăng nhập admin - tạo ngẫu nhiên, KHÔNG dùng giá trị mẫu này khi lên production
# Có thể tạo bằng lệnh: openssl rand -base64 32
AUTH_SECRET="doi-chuoi-nay-thanh-gia-tri-ngau-nhien-that-dai"

# Tài khoản admin khởi tạo khi chạy "npm run seed" lần đầu
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="doi-mat-khau-nay"

# Domain thật của website - dùng để sinh sitemap.xml và các thẻ SEO
SITE_URL="https://www.duongthuylimousine.top"
